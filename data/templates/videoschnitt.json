   "encoders": [
    {
     "label": "Bild",
     "rotate": null,
     "press": {
      "type": "hotkey",
      "keys": "KEY_SPACE"
     },
     "left": {
      "type": "hotkey",
      "keys": "KEY_LEFT"
     },
     "right": {
      "type": "hotkey",
      "keys": "KEY_RIGHT"
     },
     "strip": "name_value"
    },
    {
     "label": "Zoom KDL",
     "rotate": null,
     "press": null,
     "left": {
      "type": "hotkey",
      "keys": "KEY_LEFTCTRL+KEY_SLASH"
     },
     "right": {
      "type": "hotkey",
      "keys": "KEY_LEFTCTRL+KEY_RIGHTBRACE"
     },
     "strip": "name_value"
    },
    {
     "label": "Zoom DVR",
     "rotate": null,
     "press": null,
     "left": {
      "type": "hotkey",
      "keys": "KEY_LEFTCTRL+KEY_SLASH"
     },
     "right": {
      "type": "hotkey",
      "keys": "KEY_LEFTCTRL+KEY_LEFTSHIFT+KEY_0"
     },
     "strip": "name_value"
    },
    {
     "label": "Schnitt DVR",
     "rotate": null,
     "press": null,
     "left": {
      "type": "hotkey",
      "keys": "KEY_UP"
     },
     "right": {
      "type": "hotkey",
      "keys": "KEY_DOWN"
     },
     "strip": "name_value"
    },
    {
     "label": "Verlauf",
     "rotate": null,
     "press": null,
     "left": {
      "type": "hotkey",
      "keys": "KEY_LEFTCTRL+KEY_Y"
     },
     "right": {
      "type": "hotkey",
      "keys": "KEY_LEFTCTRL+KEY_LEFTSHIFT+KEY_Y"
     },
     "strip": "name_value"
    },
    {
     "label": "Lautstärke",
     "rotate": {
      "type": "volume"
     },
     "press": {
      "type": "mute_toggle"
     },
     "left": null,
     "right": null,
     "strip": "bar"
    }
   ],
   "wheel": {
    "display": "label",
    "label": "Bild",
    "left": {
     "type": "hotkey",
