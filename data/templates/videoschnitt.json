        "bg": "#000000",
        "icon": "svg:icons/MediaNextTrack.svg",
        "text": "Vorwärts",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_I"
       },
       "image": {
        "bg": "#000000",
        "icon": null,
        "text": "In-Punkt",
        "layout": "text"
       }
      },
