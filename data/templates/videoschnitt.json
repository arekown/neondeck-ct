       "image": {
        "bg": "#000000",
        "icon": "svg:icons/MediaStop.svg",
        "text": "Stopp",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_L"
