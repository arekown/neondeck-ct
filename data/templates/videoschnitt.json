{
 "version": 2,
 "id": "videoschnitt",
 "name": "Videoschnitt (Kdenlive, DaVinci Resolve)",
 "description": "Kdenlive und DaVinci Resolve fokussieren oder starten, Wiedergabe mit J/K/L, In/Out, Schneiden, Marker/Guide und Werkzeuge je Programm; Rad bildweise, Regler für Zeitleisten-Zoom und Verlauf.",
 "app_ids": [],
 "dynamic": true,
 "hold_profile": false,
 "round": {},
 "square": {},
 "workspaces": [
  {
   "id": "ws1",
   "name": "Videoschnitt",
   "touch_pages": [
    {
     "id": "p1",
     "name": "Kdenlive",
     "buttons": [
      {
       "action": {
        "type": "app_focus",
        "app_id": "org.kde.kdenlive"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/OpenApp.svg",
        "text": "Kdenlive",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_SPACE"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/MediaPlayPause.svg",
        "text": "Play",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_J"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/MediaPrevTrack.svg",
        "text": "Rückwärts",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_K"
