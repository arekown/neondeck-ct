  "7": {
   "action": {
    "type": "kde",
    "name": "overview"
   }
  },
  "8": {
   "action": {
    "type": "kde",
    "name": "desktop_previous"
   }
  },
  "9": {
   "action": {
    "type": "kde",
    "name": "desktop_next"
   }
  },
  "10": {
   "action": {
    "type": "kde",
    "name": "show_desktop"
   }
  }
 },
