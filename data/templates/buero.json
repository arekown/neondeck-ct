{
 "version": 2,
 "id": "buero",
 "name": "Büro (LibreOffice, Thunderbird)",
 "description": "LibreOffice Writer und Calc sowie Thunderbird fokussieren oder starten, Fett/Kursiv/Unterstrichen, Listen, Speichern und Drucken, neue Mail, Antworten, Weiterleiten und Kalender; Regler für Verlauf, Seiten, Tabellenblätter und Nachrichten.",
 "app_ids": [],
