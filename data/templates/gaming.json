{
 "version": 2,
 "id": "gaming",
 "name": "Gaming (Steam, Lutris, Discord)",
 "description": "Steam, Lutris, Heroic und Discord fokussieren oder starten, Mikrofon und Ton stumm, Audioausgang wechseln, Lautstärke-Mixer, MangoHud, Bildschirmfoto; Regler je Anwendung.",
 "app_ids": [],
 "dynamic": true,
 "hold_profile": false,
 "round": {},
 "square": {},
