  {
   "id": "ws1",
   "name": "Gaming",
   "touch_pages": [
    {
     "id": "p1",
     "name": "Gaming",
     "buttons": [
      {
       "action": {
        "type": "app_focus",
        "app_id": "steam"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/OpenApp.svg",
        "text": "Steam",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "app_focus",
        "app_id": "net.lutris.Lutris"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/OpenApp.svg",
        "text": "Lutris",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "app_focus",
        "app_id": "com.heroicgameslauncher.hgl"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/OpenApp.svg",
        "text": "Heroic",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "app_focus",
        "app_id": "com.discordapp.Discord"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/ChatMessage.svg",
        "text": "Discord",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "mic_mute"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/MediaMuteMic.svg",
        "text": "Mikro",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "mute_toggle"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/MediaVolumeMute.svg",
        "text": "Ton aus",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "audio_output_next"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/MediaHeadphones.svg",
        "text": "Ausgang",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "dynamic_folder",
        "kind": "mixer"
