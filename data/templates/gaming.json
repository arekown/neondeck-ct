       "image": {
        "bg": "#000000",
        "icon": "svg:icons/BarGraph.svg",
        "text": "Mixer",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_RIGHTSHIFT+KEY_F12"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/Monitor.svg",
        "text": "HUD",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "kde",
        "name": "screenshot"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/Screenshot.svg",
        "text": "Foto",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "media",
        "key": "play_pause"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/MediaPlayPause.svg",
        "text": "Musik",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "kde",
        "name": "overview"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/SwitchPages.svg",
        "text": "Fenster",
        "layout": "icon_text"
       }
      }
     ]
    }
