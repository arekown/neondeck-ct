{
 "version": 2,
 "id": "browser",
 "name": "Browser (Brave, Firefox)",
 "description": "Brave und Firefox fokussieren oder starten, Tabs öffnen, schließen und wiederherstellen, Zurück/Vor, Neu laden, Lesezeichen, privates Fenster, Downloads und Seitenwerkzeuge; Regler für Tabs, Zoom, Scrollen und Verlauf.",
 "app_ids": [],
 "dynamic": true,
 "hold_profile": false,
 "round": {},
 "square": {},
 "workspaces": [
  {
   "id": "ws1",
   "name": "Browser",
   "touch_pages": [
    {
     "id": "p1",
     "name": "Browser",
     "buttons": [
      {
       "action": {
        "type": "app_focus",
        "app_id": "brave-browser"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/OpenApp.svg",
        "text": "Brave",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "app_focus",
        "app_id": "org.mozilla.firefox"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/OpenApp.svg",
        "text": "Firefox",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_T"
       },
       "image": {
        "bg": "#000000",
        "icon": null,
        "text": "Neuer Tab",
        "layout": "text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_W"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/Close.svg",
        "text": "Tab zu",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_LEFTSHIFT+KEY_T"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/Redo.svg",
        "text": "Wieder auf",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTALT+KEY_LEFT"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/ArrowLeft.svg",
        "text": "Zurück",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTALT+KEY_RIGHT"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/ArrowRight.svg",
        "text": "Vor",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_F5"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/Refresh.svg",
        "text": "Neu laden",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_D"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/Bookmark.svg",
        "text": "Lesezeich.",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_LEFTSHIFT+KEY_N"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/Lock.svg",
        "text": "Privat",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_L"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/SearchComputer.svg",
        "text": "Adresse",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_J"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/CircleArrowDown.svg",
        "text": "Downloads",
        "layout": "icon_text"
       }
      }
     ]
    },
    {
     "id": "p2",
     "name": "Seite",
     "buttons": [
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_F"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/SearchComputer.svg",
        "text": "Suchen",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_F11"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/Monitor.svg",
        "text": "Vollbild",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_0"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/SmartZoom.svg",
        "text": "Zoom 100 %",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_H"
       },
       "image": {
        "bg": "#000000",
        "icon": null,
        "text": "Verlauf",
        "layout": "text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_LEFTSHIFT+KEY_B"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/BookmarkFilled.svg",
        "text": "Leiste",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_F12"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/Settings.svg",
        "text": "Entwickler",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_U"
       },
       "image": {
        "bg": "#000000",
        "icon": null,
        "text": "Quelltext",
        "layout": "text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_P"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/Print.svg",
        "text": "Drucken",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_S"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/OpenFile.svg",
        "text": "Speichern",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTALT+KEY_HOME"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/Home.svg",
        "text": "Startseite",
        "layout": "icon_text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_N"
       },
       "image": {
        "bg": "#000000",
        "icon": null,
        "text": "Neues Fen.",
        "layout": "text"
       }
      },
      {
       "action": {
        "type": "hotkey",
        "keys": "KEY_LEFTCTRL+KEY_LEFTSHIFT+KEY_P"
       },
       "image": {
        "bg": "#000000",
        "icon": "svg:icons/Lock.svg",
        "text": "Privat FF",
        "layout": "icon_text"
       }
      }
     ]
    }
   ],
   "encoders": [
    {
     "label": "Tabs",
     "rotate": null,
     "press": {
      "type": "hotkey",
      "keys": "KEY_LEFTCTRL+KEY_T"
     },
     "left": {
      "type": "hotkey",
      "keys": "KEY_LEFTCTRL+KEY_PAGEUP"
     },
     "right": {
      "type": "hotkey",
      "keys": "KEY_LEFTCTRL+KEY_PAGEDOWN"
     },
     "strip": "name_value"
    },
    {
     "label": "Zoom",
     "rotate": null,
     "press": {
      "type": "hotkey",
      "keys": "KEY_LEFTCTRL+KEY_0"
     },
     "left": {
      "type": "hotkey",
      "keys": "KEY_LEFTCTRL+KEY_SLASH"
     },
     "right": {
      "type": "hotkey",
      "keys": "KEY_LEFTCTRL+KEY_RIGHTBRACE"
     },
     "strip": "name_value"
    },
    {
     "label": "Scrollen",
     "rotate": null,
     "press": null,
     "left": {
      "type": "hotkey",
      "keys": "KEY_UP"
     },
     "right": {
      "type": "hotkey",
      "keys": "KEY_DOWN"
     },
     "strip": "name_value"
    },
    {
     "label": "Verlauf",
     "rotate": null,
     "press": null,
     "left": {
      "type": "hotkey",
      "keys": "KEY_LEFTALT+KEY_LEFT"
     },
     "right": {
      "type": "hotkey",
      "keys": "KEY_LEFTALT+KEY_RIGHT"
     },
     "strip": "name_value"
    },
    {
     "label": "Lautstärke",
     "rotate": {
      "type": "volume"
     },
     "press": {
      "type": "mute_toggle"
     },
     "left": null,
     "right": null,
     "strip": "bar"
    },
    {
     "label": "",
     "rotate": null,
     "press": null,
     "left": null,
     "right": null,
     "strip": "name_value"
    }
   ],
   "wheel": {
    "display": "label",
    "label": "Scrollen",
    "left": {
     "type": "hotkey",
     "keys": "KEY_UP"
    },
    "right": {
     "type": "hotkey",
     "keys": "KEY_DOWN"
    }
   },
   "led_color": "#ff6000"
  }
 ],
 "home_workspace": "ws1"
}
