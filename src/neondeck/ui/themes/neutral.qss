/* Neutral Dunkel – ruhiges, modernes Dunkel ohne Effekte.
   Platzhalter {schluessel} / {schluessel@prozent} setzt theme.py ein. */

QMainWindow, QDialog { background: {bg}; }
QWidget {
    font-family: "{font_ui}";
    font-size: {font_pt}pt;
    color: {text};
    selection-background-color: {accent@45};
    selection-color: {bright};
}
QLabel, QCheckBox, QRadioButton { background: transparent; }
QLabel:disabled, QCheckBox:disabled, QRadioButton:disabled { color: {text_dim}; }
QLabel#heading { font-family: "{font_head}"; font-size: 12pt; font-weight: 600; color: {text}; }
QLabel#hint { color: {text_dim}; }
QLabel#error { color: {danger}; }

/* --- Menues, Werkzeugleiste, Statuszeile ----------------------------------------- */
QMenuBar { background: {bg}; border-bottom: 1px solid {line}; padding: 2px 6px; }
QMenuBar::item { background: transparent; padding: 4px 10px; border-radius: 6px; }
QMenuBar::item:selected { background: {panel}; }
QMenuBar::item:pressed { background: {accent@25}; }

QMenu {
    background: {bg2};
    border: 1px solid {line};
    border-radius: 8px;
    padding: 5px;
}
QMenu::item { background: transparent; padding: 5px 26px 5px 24px; border-radius: 5px; }
QMenu::item:selected { background: {accent@30}; color: {bright}; }
QMenu::item:disabled { color: {text_dim}; }
QMenu::separator { height: 1px; background: {line}; margin: 5px 8px; }
QMenu::icon { padding-left: 6px; }
QMenu::indicator { width: 10px; height: 10px; left: 8px; border-radius: 3px; }
QMenu::indicator:non-exclusive:unchecked,
QMenu::indicator:exclusive:unchecked { border: 1px solid {text_dim}; background: transparent; }
QMenu::indicator:non-exclusive:checked,
QMenu::indicator:exclusive:checked { border: 1px solid {accent}; background: {accent}; }
QMenu::indicator:non-exclusive:checked { image: url("{icon:check:bright}"); }
QMenu::indicator:exclusive { border-radius: 5px; }

QToolBar {
    background: {bg};
    border: none;
    border-bottom: 1px solid {line};
    padding: 5px 10px;
    spacing: 6px;
}
QToolBar::separator { width: 1px; background: {line}; margin: 4px 10px; }

QStatusBar { background: {bg}; border-top: 1px solid {line}; color: {text_dim}; }
QStatusBar::item { border: none; }

QToolTip {
    background: {panel};
    color: {text};
    border: 1px solid {line};
    border-radius: 6px;
    padding: 4px 7px;
}

/* --- Knoepfe ----------------------------------------------------------------------- */
QPushButton, QToolButton {
    color: {text};
    background: {panel};
    border: 1px solid {line};
    border-radius: 6px;
    padding: 4px 12px;
    min-height: 20px;
}
QToolButton { padding: 4px 8px; }
QPushButton:hover, QToolButton:hover { background: {line}; }
QPushButton:pressed, QToolButton:pressed, QToolButton:checked, QPushButton:checked {
    background: {accent@35};
    border-color: {accent};
}
QPushButton:focus, QToolButton:focus { border-color: {accent}; }
QPushButton:default { color: {bright}; background: {accent}; border-color: {accent}; }
QPushButton:default:hover { background: {accent_dim}; }
QPushButton:disabled, QToolButton:disabled {
    color: {text_dim@70};
    background: transparent;
    border-color: {line};
}
QPushButton::menu-indicator { subcontrol-position: right center; right: 4px; }
QToolBar QToolButton { background: transparent; border-color: transparent; }
QToolBar QToolButton:hover { background: {panel}; }

/* --- Eingaben ------------------------------------------------------------------------ */
QLineEdit, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit, QComboBox,
QKeySequenceEdit {
    color: {text};
    background: {bg2};
    border: 1px solid {line};
    border-radius: 6px;
    padding: 3px 7px;
    min-height: 20px;
}
QComboBox { padding-right: 22px; }
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QPlainTextEdit:hover,
QTextEdit:hover, QComboBox:hover { border-color: {text_dim@60}; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus,
QTextEdit:focus, QComboBox:focus, QComboBox:on { border-color: {accent}; }
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled, QPlainTextEdit:disabled {
    color: {text_dim};
    background: {bg};
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
}
QComboBox::down-arrow { image: url("{icon:arrow_down:text_dim}"); width: 10px; height: 10px; }
QComboBox::down-arrow:on, QComboBox::down-arrow:hover { image: url("{icon:arrow_down:text}"); }
QComboBox::down-arrow:disabled { image: url("{icon:arrow_down:line}"); }
QComboBox QAbstractItemView {
    background: {bg2};
    color: {text};
    border: 1px solid {line};
    outline: 0;
    selection-background-color: {accent@35};
    selection-color: {bright};
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    border: none;
    background: transparent;
}
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-position: top right; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-position: bottom right; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background: {panel}; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url("{icon:arrow_up:text_dim}"); width: 8px; height: 8px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url("{icon:arrow_down:text_dim}"); width: 8px; height: 8px;
}

QCheckBox, QRadioButton { spacing: 8px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid {text_dim};
    border-radius: 4px;
    background: {bg2};
}
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: {accent}; }
QCheckBox::indicator:checked {
    border-color: {accent};
    background: {accent};
    image: url("{icon:check:bright}");
}
QRadioButton::indicator:checked {
    border-color: {accent};
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
                                stop:0 {accent}, stop:0.5 {accent}, stop:0.62 {bg2},
                                stop:1 {bg2});
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border-color: {line}; }

/* --- Gruppen, Listen, Baeume, Reiter ---------------------------------------------- */
QGroupBox {
    font-weight: 600;
    background: {bg2};
    border: 1px solid {line};
    border-radius: 8px;
    margin-top: 14px;
    padding: 14px 8px 8px 8px;
}
QGroupBox QWidget { font-weight: normal; }
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: {text_dim};
}

QAbstractItemView {
    background: {bg2};
    alternate-background-color: {panel};
    border: 1px solid {line};
    border-radius: 6px;
    outline: 0;
}
QTreeView::item, QListView::item { padding: 3px 4px; border: none; border-radius: 4px; }
QTreeView::item:hover, QListView::item:hover { background: {panel}; }
QTreeView::item:selected, QListView::item:selected { background: {accent@35}; color: {bright}; }
QTreeView::branch:selected { background: {accent@35}; }
QTreeView::item:disabled, QListView::item:disabled { color: {text_dim}; }
QHeaderView::section {
    color: {text_dim};
    background: {bg2};
    border: none;
    border-bottom: 1px solid {line};
    padding: 4px 6px;
}

QTabBar { qproperty-drawBase: 0; }
QTabBar::tab {
    color: {text_dim};
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 14px;
    margin-right: 4px;
    min-height: 18px;
}
QTabBar::tab:hover:!selected { color: {text}; background: {panel}; }
QTabBar::tab:selected { color: {text}; background: {panel}; border-color: {line}; }
QTabWidget::pane { border: 1px solid {line}; border-radius: 8px; background: {bg2}; }

/* --- Rollbalken, Teiler, Rahmen --------------------------------------------------- */
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; border: none; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; border: none; }
QScrollBar::handle:vertical {
    background: {line}; min-height: 28px; margin: 2px; border-radius: 3px;
}
QScrollBar::handle:horizontal {
    background: {line}; min-width: 28px; margin: 2px; border-radius: 3px;
}
QScrollBar::handle:hover { background: {text_dim}; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QSplitter::handle { background: transparent; }
QSplitter::handle:horizontal { width: 6px; }
QSplitter::handle:vertical { height: 6px; }
QSplitter::handle:hover { background: {line}; }

QFrame[frameShape="4"], QFrame[frameShape="5"] { color: {line}; }   /* HLine, VLine */

QProgressBar {
    border: 1px solid {line};
    border-radius: 6px;
    background: {bg2};
    text-align: center;
}
QProgressBar::chunk { background: {accent}; border-radius: 5px; }
QSlider::groove:horizontal { height: 4px; background: {line}; border-radius: 2px; }
QSlider::sub-page:horizontal { background: {accent}; border-radius: 2px; }
QSlider::handle:horizontal {
    width: 14px; margin: -6px 0; border-radius: 7px; background: {text};
}

/* --- Diagnose, Simulieren (P13) ------------------------------------------------------ */
QLabel#ok { color: {ok}; }
QPlainTextEdit#fix { font-family: "{font_mono}"; font-size: 9.5pt; }
QToolBar QToolButton#simulate:checked {
    background: {accent2};
    border-color: {accent2};
    color: {bg};
    font-weight: bold;
}
QLabel#simulate {
    background: {accent2};
    color: {bg};
    font-weight: bold;
    padding: 1px 10px;
}
